# Copie para infra/.env na VPS (nunca commitar) e preencha.
# Gere senhas e segredos com: openssl rand -base64 32

DOMINIO=gestao.exemplo.com.br

# Traefik já existente na VPS (confirmar no inventário)
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Postgres: admin (migrações e backup) e usuário da aplicação (só dados)
PG_ADMIN_USER=gestao_admin
PG_ADMIN_PASSWORD=
PG_APP_USER=gestao_app
PG_APP_PASSWORD=
BACKUP_MANTER_DIAS=14

# IA (basta uma)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
IA_PROVEDOR=

# Segredos do app
SESSAO_SEGREDO=
N8N_TOKEN=
