# Copie para .env.local (local) ou configure nas variáveis de ambiente da Vercel.
# Basta UMA das chaves. Sem nenhuma, a interpretação por texto livre usa regras simples.

# OpenAI (usado nos testes)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Anthropic (provedor previsto no spec para produção)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Opcional: força um provedor quando as duas chaves existirem (openai | anthropic)
IA_PROVEDOR=
